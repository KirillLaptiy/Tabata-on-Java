<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="32dp">

    <ImageButton
        android:id="@+id/tabataEdit"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitXY"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_gravity="center"
        android:src="@drawable/tabata_edit"
        android:contentDescription="@string/todo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tabataName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="@string/tabata_name"
            android:textColor="#1E1E1E"
            android:fontFamily="@font/roboto_bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tabataSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/roboto_bold"
            android:text="@string/tabata_settings"
            android:textColor="#596068"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/tabataStart"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitXY"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_gravity="center"
        android:src="@drawable/tabata_start"
        android:contentDescription="@string/todo" />
</LinearLayout>