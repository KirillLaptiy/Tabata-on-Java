<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/tabataTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="39dp"
        android:layout_marginTop="110dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.myapplication.home_fragment.ClockView
            android:id="@+id/clockView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_horizontal"
            android:gravity="center">

        <TextView
            android:id="@+id/stageNameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:alpha="0.4"
            android:letterSpacing="-0.01"
            android:textColor="#596068"
            android:fontFamily="@font/roboto_bold"
            android:text="@string/workout"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/stageTimeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/_00_00"
            android:fontFamily="@font/roboto_light"
            android:letterSpacing="-0.01"
            android:textColor="#1D7966"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginTop="25dp"
            android:alpha="0.4"
            android:letterSpacing="-0.01"
            android:textColor="#596068"
            android:text="@string/round"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/stageRoundView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#596068"
            android:text="@string/_1_1"
            android:textSize="20sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="71.5dp"
        android:layout_marginTop="65dp"
        app:layout_constraintStart_toStartOf="@id/tabataTimer"
        app:layout_constraintTop_toBottomOf="@id/tabataTimer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabataDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/circular_button"
            app:backgroundTint="#1D7966"
            app:icon="@drawable/ic_tabata_delete"
            app:iconTint="#1D7966"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabataRun"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/oval"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_tabata_run"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabataRestart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/circular_button"
            app:backgroundTint="#1D7966"
            app:icon="@drawable/ic_tabata_restart"
            app:iconTint="#1D7966"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="16dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>