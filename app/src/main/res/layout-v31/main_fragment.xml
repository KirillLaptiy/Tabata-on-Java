<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/main_tabata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/tabataImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/todo"
            android:background="@drawable/rounded_image_button"
            android:clipToOutline="true"
            app:srcCompat="@drawable/main_tabata"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:textSize="40sp"
            android:textFontWeight="700"
            android:fontFamily="@font/ubuntu_bold"
            android:text="@string/tabata"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="@id/tabataImage"
            app:layout_constraintTop_toTopOf="@id/tabataImage"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_right"
            android:layout_marginStart="317dp"
            android:layout_marginTop="177dp"
            android:background="@drawable/arrow_right"
            android:contentDescription="@string/todo"
            app:layout_constraintStart_toStartOf="@id/tabataImage"
            app:layout_constraintTop_toTopOf="@id/tabataImage"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/main_workouts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="235dp"
        app:layout_constraintStart_toStartOf="@+id/main_tabata"
        app:layout_constraintTop_toTopOf="@+id/main_tabata">

        <ImageButton
            android:id="@+id/workoutsImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_image_button"
            android:clipToOutline="true"
            android:contentDescription="@string/todo"
            app:srcCompat="@drawable/main_workouts" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/ubuntu_bold"
            android:text="@string/workout_programs"
            android:textColor="@color/white"
            android:textFontWeight="700"
            android:textSize="40sp"
            app:layout_constraintStart_toStartOf="@id/workoutsImage"
            app:layout_constraintTop_toTopOf="@id/workoutsImage" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_right"
            android:layout_marginStart="317dp"
            android:layout_marginTop="177dp"
            android:background="@drawable/arrow_right"
            android:contentDescription="@string/todo"
            app:layout_constraintStart_toStartOf="@id/tabataImage"
            app:layout_constraintTop_toTopOf="@id/tabataImage"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>